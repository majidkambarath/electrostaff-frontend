# Backend the dev/preview server proxies /api to (npm run dev / npm run preview).
BACKEND_URL=http://localhost:5000

# Full API base the browser calls, including /api. Leave empty to use the proxy (same-origin /api).
# Set it when the frontend is hosted separately from the backend and rebuild, e.g.:
# VITE_API_URL=https://api.example.com/api
VITE_API_URL=
